// HiTouch Events + Integrated CRM — PostgreSQL schema (Prisma 7)

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Auth.js (NextAuth) — https://authjs.dev/reference/adapter/prisma
// -----------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  adminProfile  AdminUser?
  portalAccount PortalAccount?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -----------------------------------------------------------------------------
// Admin + audit
// -----------------------------------------------------------------------------

enum AdminRole {
  COORDINATOR
  SUPERADMIN
}

model AdminUser {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AdminRole @default(COORDINATOR)
  createdAt DateTime @default(now())

  reviewedPending   PendingSubmission[] @relation("PendingReviewedBy")
  broadcastsCreated VendorBroadcast[]
  auditLogs         AuditLog[]
  activitiesCreated ContactActivity[]
  vendorReviewsCreated VendorReview[]
  dealsOwned         Deal[]              @relation("DealOwner")
  tasksAssigned      CrmTask[]           @relation("TaskAssignee")
  tasksCreated       CrmTask[]           @relation("TaskCreator")
  contactListsCreated ContactList[]
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      AdminUser @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String
  payload    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// External portal accounts (magic-link login)
// -----------------------------------------------------------------------------

enum PortalKind {
  CLIENT
  VENDOR
}

model PortalAccount {
  id          String     @id @default(cuid())
  userId      String     @unique
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactId   String     @unique
  contact     Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind        PortalKind
  enabled     Boolean    @default(true)
  invitedAt   DateTime?
  lastLoginAt DateTime?
  createdAt   DateTime   @default(now())

  @@index([kind, enabled])
}

// -----------------------------------------------------------------------------
// CRM: companies & contacts
// -----------------------------------------------------------------------------

model Company {
  id         String   @id @default(cuid())
  name       String
  website    String?
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  contacts   Contact[]
  clientTags CompanyHiTouchClient[]
  activities ContactActivity[]
  deals      Deal[]
  tasks      CrmTask[]
}

model Contact {
  id         String   @id @default(cuid())
  email      String   @unique
  phone      String?
  firstName  String?
  lastName   String?
  title      String?
  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id])
  notes      String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clientTags    ContactHiTouchClient[]
  vendorSkills  ContactVendorSkill[]
  engagements   VendorEngagement[]
  activities    ContactActivity[]
  vendorReviews VendorReview[]
  wonProjects   EventProject[] @relation("ProjectWinner")
  portalAccount PortalAccount?
  deals         Deal[]
  tasks         CrmTask[]
  listMemberships ContactListMember[]

  @@index([companyId])
}

// -----------------------------------------------------------------------------
// CRM activity timeline (generic notes — separate from VendorReview)
// -----------------------------------------------------------------------------

enum ActivityKind {
  NOTE
  CALL
  EMAIL
  MEETING
  SYSTEM
}

model ContactActivity {
  id          String       @id @default(cuid())
  contactId   String
  contact     Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id])
  kind        ActivityKind @default(NOTE)
  body        String       @db.Text
  occurredAt  DateTime     @default(now())
  createdById String?
  createdBy   AdminUser?   @relation(fields: [createdById], references: [id])
  meta        Json?

  @@index([contactId, occurredAt(sort: Desc)])
  @@index([companyId, occurredAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// Vendor performance reviews (isolated from Contact.notes)
// -----------------------------------------------------------------------------

model VendorReview {
  id              String        @id @default(cuid())
  contactId       String
  contact         Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  projectId       String?
  project         EventProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  hiTouchClientId String?
  hiTouchClient   HiTouchClient? @relation(fields: [hiTouchClientId], references: [id])
  rating          Int
  headline        String?
  body            String        @db.Text
  internalNotes   String?       @db.Text
  reviewerName    String?
  eventDate       DateTime?
  createdById     String
  createdBy       AdminUser     @relation(fields: [createdById], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([contactId, createdAt(sort: Desc)])
  @@index([projectId])
}

// -----------------------------------------------------------------------------
// HiTouch clients (global) + M2M tagging
// -----------------------------------------------------------------------------

enum ClientKind {
  NONPROFIT
  CORPORATE
  OTHER
}

model HiTouchClient {
  id        String      @id @default(cuid())
  name      String      @unique
  slug      String      @unique
  kind      ClientKind  @default(NONPROFIT)
  notes     String?     @db.Text
  createdAt DateTime    @default(now())

  contacts      ContactHiTouchClient[]
  companies     CompanyHiTouchClient[]
  projects      EventProject[]
  vendorReviews VendorReview[]
  deals         Deal[]
}

model ContactHiTouchClient {
  contactId       String
  hiTouchClientId String
  isPrimary       Boolean @default(false)
  notes           String?

  contact       Contact       @relation(fields: [contactId], references: [id], onDelete: Cascade)
  hiTouchClient HiTouchClient @relation(fields: [hiTouchClientId], references: [id], onDelete: Cascade)

  @@id([contactId, hiTouchClientId])
  @@index([hiTouchClientId])
}

model CompanyHiTouchClient {
  companyId       String
  hiTouchClientId String
  notes           String?

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  hiTouchClient HiTouchClient @relation(fields: [hiTouchClientId], references: [id], onDelete: Cascade)

  @@id([companyId, hiTouchClientId])
  @@index([hiTouchClientId])
}

// -----------------------------------------------------------------------------
// Public intake gate (never writes operational CRM until approved)
// -----------------------------------------------------------------------------

enum IntakeCategory {
  POTENTIAL_CLIENT
  POTENTIAL_VENDOR
  SPONSOR
  ATTENDEE_GUEST
  PARTNER_OR_FUTURE_EMPLOYEE
}

enum PendingStatus {
  PENDING
  APPROVED
  DECLINED
  SPAM
}

model PendingSubmission {
  id           String         @id @default(cuid())
  createdAt    DateTime       @default(now())
  status       PendingStatus  @default(PENDING)
  fullName     String
  email        String
  phone        String?
  organization String?
  message      String?        @db.Text
  categories   IntakeCategory[]
  meta         Json?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   AdminUser?     @relation("PendingReviewedBy", fields: [reviewedById], references: [id])

  @@index([status, createdAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// Marketing case studies (public portfolio)
// -----------------------------------------------------------------------------

model CaseStudy {
  id              String   @id @default(cuid())
  slug            String   @unique
  title           String
  category        String
  listDescription String   @db.Text
  /// Stored as JSON: string[] paragraphs (matches legacy `body` array)
  body            Json
  heroImageUrl    String
  sortDate        DateTime
  published       Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([published, sortDate(sort: Desc)])
}

// -----------------------------------------------------------------------------
// Internal event projects + vendor lifecycle
// -----------------------------------------------------------------------------

enum EventVenueType {
  INDOOR
  OUTDOOR
}

enum EventProjectStatus {
  DRAFT
  PLANNING
  ACTIVE
  COMPLETED
}

model EventProject {
  id              String   @id @default(cuid())
  name            String
  hiTouchClientId String?
  hiTouchClient   HiTouchClient? @relation(fields: [hiTouchClientId], references: [id])
  winnerContactId String?
  winnerContact   Contact? @relation("ProjectWinner", fields: [winnerContactId], references: [id], onDelete: SetNull)
  location        String?
  venueType       EventVenueType?
  guestCount      Int?
  status          EventProjectStatus @default(DRAFT)
  budgetUsd       Decimal? @db.Decimal(12, 2)
  startsAt        DateTime?
  endsAt          DateTime?
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  broadcasts    VendorBroadcast[]
  vendorReviews VendorReview[]
  deals         Deal[]

  @@index([winnerContactId])
  @@index([status, updatedAt(sort: Desc)])
}

// -----------------------------------------------------------------------------
// HubSpot-style CRM core: deals pipeline, tasks, contact lists
// -----------------------------------------------------------------------------

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model Deal {
  id              String     @id @default(cuid())
  name            String
  stage           DealStage  @default(LEAD)
  amount          Decimal?   @db.Decimal(12, 2)
  currency        String     @default("USD")
  closeDate       DateTime?
  contactId       String?
  contact         Contact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId       String?
  company         Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  hiTouchClientId String?
  hiTouchClient   HiTouchClient? @relation(fields: [hiTouchClientId], references: [id], onDelete: SetNull)
  projectId       String?
  project         EventProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  ownerId         String?
  owner           AdminUser? @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  notes           String?    @db.Text
  stageEnteredAt  DateTime   @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tasks CrmTask[]

  @@index([stage, updatedAt(sort: Desc)])
  @@index([ownerId])
  @@index([contactId])
  @@index([companyId])
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model CrmTask {
  id           String       @id @default(cuid())
  title        String
  body         String?      @db.Text
  status       TaskStatus   @default(NOT_STARTED)
  priority     TaskPriority @default(MEDIUM)
  dueAt        DateTime?
  completedAt  DateTime?
  contactId    String?
  contact      Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  companyId    String?
  company      Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  dealId       String?
  deal         Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  assignedToId String?
  assignedTo   AdminUser?   @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    AdminUser    @relation("TaskCreator", fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([assignedToId, dueAt])
  @@index([status, dueAt])
  @@index([dealId])
}

model ContactList {
  id          String   @id @default(cuid())
  name        String
  description String?  @db.Text
  createdById String
  createdBy   AdminUser @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members ContactListMember[]

  @@index([name])
}

model ContactListMember {
  listId    String
  contactId String
  addedAt   DateTime @default(now())

  list    ContactList @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
  @@index([contactId])
}

model VendorSkillCategory {
  id      String @id @default(cuid())
  key     String @unique
  label   String

  broadcasts      VendorBroadcast[]
  contactSkills   ContactVendorSkill[]
}

model ContactVendorSkill {
  contactId  String
  categoryId String

  contact  Contact             @relation(fields: [contactId], references: [id], onDelete: Cascade)
  category VendorSkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([contactId, categoryId])
  @@index([categoryId])
}

enum VendorEngagementStatus {
  QUEUED
  SENT
  DELIVERED
  OPENED
  REPLIED
  DECLINED_BY_ADMIN
  NOT_SELECTED
  SELECTED_WINNER
  BOUNCE
  COMPLAINT
}

model VendorBroadcast {
  id               String   @id @default(cuid())
  projectId        String
  project          EventProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  categoryId       String
  category         VendorSkillCategory @relation(fields: [categoryId], references: [id])
  subject          String
  bodyHtml         String   @db.Text
  createdById      String
  createdBy        AdminUser @relation(fields: [createdById], references: [id])
  createdAt        DateTime @default(now())
  dispatchedAt     DateTime?
  staleAfterHours  Int      @default(72)
  winnerContactId  String?
  refusalBatchSentAt DateTime?

  engagements VendorEngagement[]

  @@index([projectId])
  @@index([createdAt])
}

model VendorEngagement {
  id           String                  @id @default(cuid())
  broadcastId  String
  broadcast    VendorBroadcast         @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contactId    String
  contact      Contact                 @relation(fields: [contactId], references: [id], onDelete: Cascade)
  status       VendorEngagementStatus  @default(QUEUED)
  selectedAt   DateTime?
  lastOpenedAt DateTime?
  lastReplyAt  DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  messages      EmailMessage[]
  notifications AdminNotification[]

  @@unique([broadcastId, contactId])
  @@index([broadcastId, status])
  @@index([contactId])
}

enum EmailDirection {
  OUTBOUND
  INBOUND
}

enum EmailEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  BOUNCED
  COMPLAINT
  INBOUND_REPLY
}

model EmailMessage {
  id            String         @id @default(cuid())
  engagementId  String?
  engagement    VendorEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)
  toEmail       String?
  direction     EmailDirection
  provider      String
  providerMsgId String?        @unique
  inReplyTo     String?
  subject       String
  bodyHtml      String?        @db.Text
  sentAt        DateTime?
  dispatchAttempts Int         @default(0)
  lastDispatchError String?    @db.Text
  createdAt     DateTime       @default(now())

  events EmailEvent[]

  @@index([engagementId])
  @@index([createdAt])
  @@index([sentAt, direction])
}

model EmailEvent {
  id         String        @id @default(cuid())
  messageId  String
  message    EmailMessage  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  type       EmailEventType
  occurredAt DateTime      @default(now())
  meta       Json?

  @@index([messageId, occurredAt])
}

model AdminNotification {
  id           String   @id @default(cuid())
  createdAt    DateTime @default(now())
  readAt       DateTime?
  type         String
  title        String
  body         String?  @db.Text
  meta         Json?
  engagementId String?
  engagement   VendorEngagement? @relation(fields: [engagementId], references: [id], onDelete: SetNull)

  @@index([readAt, createdAt])
}
