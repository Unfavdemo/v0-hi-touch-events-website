# Copy to `.env` for local development (never commit real secrets).
# See README or ask the team for production values on Vercel.

# Site
NEXT_PUBLIC_SITE_URL=

# Database (Neon: postgresql://...?sslmode=verify-full)
DATABASE_URL=

# Admin (NextAuth)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated non-company emails allowed to sign in (same as ADMIN_TEST_EMAILS / ADMIN_ALLOWLIST_EMAILS).
ADMIN_BOOTSTRAP_EMAILS=
ADMIN_TEST_EMAILS=
ADMIN_ALLOWLIST_EMAILS=
ADMIN_EMAIL_DOMAIN=hitouchinc.com
# LOCAL ONLY: with NODE_ENV=development, any Google account can use /admin/login. Never true in production.
# AUTH_DEV_ALLOW_ANY_GOOGLE=true
# LOCAL ONLY: email/password on /admin/login when Google OAuth is not set up yet (allowlisted email required).
# AUTH_DEV_PASSWORD=

# Email (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Webhooks & cron (optional)
WEBHOOK_EMAIL_SECRET=
CRON_SECRET=
# Signs vendor email open-tracking pixel URLs; falls back to AUTH_SECRET if empty.
TRACKING_SECRET=

# Analytics (optional)
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Portal magic-link sign-in uses RESEND_API_KEY + RESEND_FROM_EMAIL (same as vendor email).
# External users: /portal/login — staff: /admin/login (Google OAuth).

# Local setup: copy this file to `.env`, then run:
#   npm run env:check
#   npm run db:push   (or npm run db:migrate in production)
#   npm run db:seed
#
# After db:seed — sample accounts (@seed.hitouch.local, safe to re-run):
#   Admin RBAC: coordinator@seed.hitouch.local | superadmin@seed.hitouch.local
#   Portal: vendor.photographer@seed.hitouch.local | client.lead@seed.hitouch.local
#   Client slices: client.peco.uac@seed.hitouch.local | client.peco.vested@seed.hitouch.local
